// VerifyCom.idl — COM 接口定义
// 通用在线验证组件，对接 verifySys 后端平台

import "oaidl.idl";
import "ocidl.idl";

[
    object,
    uuid(ED4F8B32-A73E-4D91-B5C7-8F3A1E2D6C90),
    dual,
    nonextensible,
    pointer_default(unique)
]
interface IVerifyClient : IDispatch
{
    // 登录验证：传入项目编号、注册码、机器码，返回 JSON 字符串
    // 返回: {"success":true,"code":0,"message":"...","data":{"token":"...","expireAt":...}}
    [id(1)] HRESULT Login([in] BSTR projectToken, [in] BSTR regCode, [in] BSTR machineCode, [out, retval] BSTR* pResult);

    // 心跳保活：传入登录返回的 token，刷新在线状态
    [id(2)] HRESULT Heartbeat([in] BSTR token, [out, retval] BSTR* pResult);

    // 登出
    [id(3)] HRESULT Logout([in] BSTR token, [out, retval] BSTR* pResult);

    // 解绑机器码
    [id(4)] HRESULT Unbind([in] BSTR projectToken, [in] BSTR regCode, [in] BSTR unbindPassword, [in] BSTR machineCode, [out, retval] BSTR* pResult);

    // 获取本机机器码
    [id(5)] HRESULT GetMachineCode([out, retval] BSTR* pResult);

    // 获取项目公告
    [id(6)] HRESULT GetPlacard([in] BSTR projectToken, [out, retval] BSTR* pResult);

    // 获取服务器时间（毫秒时间戳字符串）
    [id(7)] HRESULT GetServerTime([out, retval] BSTR* pResult);

    // 设置 API 服务器地址（默认 https://your-domain.com/api/client）
    // 如果开发者自部署了后端，可以用这个修改
    [id(8)] HRESULT SetApiBase([in] BSTR baseUrl);

    // 试用登录
    [id(9)] HRESULT TrialLogin([in] BSTR projectToken, [in] BSTR machineCode, [out, retval] BSTR* pResult);

    // 充值（用充值卡续期）
    [id(10)] HRESULT Charge([in] BSTR regCode, [in] BSTR cardCode, [in] BSTR machineCode, [out, retval] BSTR* pResult);

    // 自定义数据读写
    [id(11)] HRESULT GetCustomData([in] BSTR projectToken, [in] BSTR key, [out, retval] BSTR* pResult);
    [id(12)] HRESULT SetCustomData([in] BSTR projectToken, [in] BSTR key, [in] BSTR value, [out, retval] BSTR* pResult);
};

[
    uuid(D7C9E3A0-5F12-4B86-A1D4-8E2B7F3C6D95),
    version(1.0),
]
library VerifyComLib
{
    importlib("stdole2.tlb");

    [
        uuid(C3B1A7F0-9E2D-4A58-8B6C-7D3F1E5A4C82)
    ]
    coclass VerifyClient
    {
        [default] interface IVerifyClient;
    };
};
