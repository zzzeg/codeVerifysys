# GHCR 镜像前缀，格式：ghcr.io/<github-owner>/<repo>
GHCR_IMAGE_PREFIX=ghcr.io/zzzeg/codeverifysys
IMAGE_TAG=latest

# 1Panel 反向代理应转发到服务器本机的这个端口
WEB_PORT=8080

# 线上已有 MySQL，不在 docker-compose.yml 中创建数据库
# 如果 MySQL 在同一台服务器宿主机上，保持 host.docker.internal。
# 如果 MySQL 是外部服务器或 1Panel 内其他容器，请改成对应可访问地址。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=verifysys
DB_USER=verifysys
DB_PASSWORD=change-me

# 生产环境必须改成足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-secret

# 邮件验证码配置。未启用注册/找回邮件时可留空
VERIFYSYS_EMAIL_DEBUG=0
VERIFYSYS_SMTP_HOST=
VERIFYSYS_SMTP_PORT=465
VERIFYSYS_SMTP_SECURE=true
VERIFYSYS_SMTP_USER=
VERIFYSYS_SMTP_PASS=
VERIFYSYS_SMTP_FROM=
VERIFYSYS_PRODUCT_NAME=VerifySys

# 客户端协议兼容密钥。只有项目配置依赖开发密钥时才需要设置
CLIENT_DEV_SECRET=
